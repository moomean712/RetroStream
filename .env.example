# Copy to .env, or run the beginner installer. Use the LAN name or IPv4 address
# that your retro PCs use to reach this computer (no http:// and no port).
RETROSTREAM_HOSTNAME=192.168.1.50

# These defaults normally need no changes.
RETROSTREAM_WEB_PORT=8780
RETROSTREAM_STREAMING_PORT=8781
# RETROSTREAM_MAX_CACHE_BYTES=21474836480
# RETROSTREAM_RETENTION_DAYS=30
# RETROSTREAM_DEFAULT_AUDIO=audio-standard
# RETROSTREAM_DEFAULT_VIDEO=video-standard
# RETROSTREAM_MAX_TRANSCODES=2
# RETROSTREAM_MAX_STREAMS=16

# Advanced: pin a specific published version instead of latest.
# RETROSTREAM_IMAGE=ghcr.io/moomean712/retrostream:v1.0.0
